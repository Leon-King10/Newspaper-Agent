# ═══════════════════════════════════════════
# NEWSPAPER AGENT — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════
# Copy this file to .env and fill in all values.
# Never commit .env to git.

# ── GMAIL ────────────────────────────────────────────────────────────────────
# The Gmail account that SENDS the email (your non-primary Gmail).
SENDER_EMAIL=your.sender@gmail.com

# App Password for the sender account (NOT your regular Gmail password).
# How to generate one (takes ~2 minutes):
#   1. Go to myaccount.google.com → Security
#   2. Turn on 2-Step Verification if not already on
#   3. Search for "App passwords" in the Security page
#   4. Select app: Mail, device: Other → type "Newspaper Agent" → Generate
#   5. Copy the 16-character password shown (spaces don't matter)
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The Gmail address that RECEIVES the daily digest (your primary Gmail).
RECIPIENT_EMAIL=azimleon@gmail.com

# ── GOOGLE GEMINI ────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash

# ── DISPLAY ──────────────────────────────────────────────────────────────────
# Used for the date shown in the email header.
# Scheduling (9 AM) is handled by GitHub Actions cron in UTC.
LOCAL_TIMEZONE=Asia/Dhaka